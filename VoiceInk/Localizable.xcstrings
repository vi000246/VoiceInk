          }
        }
      }
    },
    "Automatically delete transcript history based on the retention period you set." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transkriptionshistorie automatisch basierend auf dem festgelegten Aufbewahrungszeitraum löschen."
          }
        },
        "zh-Hans" : {
